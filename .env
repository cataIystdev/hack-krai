# ==============================================================================
# КудыТуды — Переменные окружения
# ==============================================================================
# Этот файл содержит конфигурацию для всех сервисов инфраструктуры и
# Go-приложения. Используется Docker Compose и Viper (через internal/config).
# ==============================================================================

# --- Приложение ---------------------------------------------------------------
APP_NAME=kudytudy-api
APP_ENV=development
APP_PORT=8080
APP_LOG_LEVEL=debug

# --- PostgreSQL 16 + PostGIS --------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=kudytudy
POSTGRES_PASSWORD=kudytudy_secret_2026
POSTGRES_DB=kudytudy
POSTGRES_MAX_CONNS=20
POSTGRES_MIN_CONNS=5

# --- Redis 7 ------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_secret_2026
REDIS_DB=0

# --- Qdrant -------------------------------------------------------------------
QDRANT_HOST=localhost
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334

# --- Neo4j 5 ------------------------------------------------------------------
NEO4J_HOST=localhost
NEO4J_BOLT_PORT=7687
NEO4J_HTTP_PORT=7474
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j_secret_2026

# --- ClickHouse ---------------------------------------------------------------
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=9000
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_USER=kudytudy
CLICKHOUSE_PASSWORD=clickhouse_secret_2026
CLICKHOUSE_DB=kudytudy_analytics

# --- MinIO (S3) ---------------------------------------------------------------
MINIO_HOST=localhost
MINIO_API_PORT=9002
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=kudytudy_minio
MINIO_ROOT_PASSWORD=minio_secret_2026
MINIO_BUCKET=kudytudy-media
MINIO_USE_SSL=false

# --- JWT ----------------------------------------------------------------------
JWT_SECRET=kudytudy-super-secret-key-2026-change-in-production
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_HOURS=168
JWT_ISSUER=kudytudy-api

# --- AI (OnlySQ API) ---------------------------------------------------------
AI_BASE_URL=https://api.onlysq.ru/ai/openai/
AI_API_KEY=sq-P9j2PA2fUwFrjyfCKPdQ8SaecHSGrY22
AI_WHISPER_MODEL=whisper-1
AI_LLM_MODEL=gpt-5.1
AI_EMBEDDINGS_MODEL=local-minilm
